prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libclog
Description: Unified Logging Wrapper Library - Multi-backend logging support (DLT, DIAG, syslog, logcat, file, console)
Version: @VERSION@
Requires.private: @CLOG_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lclog @PTHREAD_LIBS@ @DLT_LIBS@ @DIAG_LIBS@ @LIBLOG_LIBS@
Cflags: -I${includedir} @CLOG_PC_CFLAGS_EXTRA@
